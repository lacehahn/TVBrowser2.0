    <script>
        async function loadVideoList() {
            const response = await fetch('cctv5.txt');
            const text = await response.text();
            // Split lines and then filter out empty lines before mapping
            const videos = text.split('\n')
                              .map(line => line.trim()) // Trim whitespace from each line
                              .filter(line => line !== '') // Filter out empty lines
                              .map(line => line.split(',')); // Then split by comma

            const videoList = document.getElementById('video-list');
            videos.forEach(video => {
                // Ensure that the line actually contains a title and a URL
                if (video.length >= 2) {
                    const li = document.createElement('li');
                    li.textContent = video[0]; // Video title
                    li.onclick = () => playVideo(video[1]); // Video URL
                    videoList.appendChild(li);
                }
            });
        }

        function playVideo(url) {
            // Check if a player instance already exists and dispose of it
            if (window.currentPlayer) {
                window.currentPlayer.dispose();
                window.currentPlayer = null; // Clear the reference
            }

            // Get the video player container
            const container = document.getElementById('video-player-container');

            // Remove existing video element if it somehow persists
            let existingVideoElement = document.getElementById('tcplayer');
            if (existingVideoElement) {
                container.removeChild(existingVideoElement);
            }

            // Create a new video element
            const newVideo = document.createElement('video');
            newVideo.id = 'tcplayer';
            newVideo.className = 'tcplayer-container'; // TCPlayer typically uses a class for its container
            newVideo.setAttribute('playsinline', 'true');
            newVideo.setAttribute('webkit-playsinline', 'true');
            // Set width and height on the video element itself or via CSS
            newVideo.style.width = '100%';
            newVideo.style.height = '100%';
            container.appendChild(newVideo);

            // Initialize TCPlayer
            // It's generally better to pass the video element ID directly or the element itself.
            window.currentPlayer = TCPlayer('tcplayer', {
                sources: [{ src: url }] 
                // fileID and appID are usually for VOD services; for direct URLs, they might not be needed.
                // If you are using Tencent Cloud VOD, make sure these are correctly populated.
                // fileID: '',
                // appID: ''
            });

            // Automatically play the video once the player is ready
            window.currentPlayer.on('ready', () => {
                window.currentPlayer.play();
            });
        }

        function filterTitles() {
            const searchValue = document.getElementById('search-box').value.toLowerCase();
            const videoList = document.getElementById('video-list').getElementsByTagName('li');
            for (let li of videoList) {
                li.style.display = li.textContent.toLowerCase().includes(searchValue) ? '' : 'none';
            }
        }

        loadVideoList();
    </script>


