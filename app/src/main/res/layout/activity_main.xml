<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_black"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:keepScreenOn="true">

    <!-- ── Full-screen WebView ── -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_black" />

    <!-- ── Error overlay ── -->
    <LinearLayout
        android:id="@+id/errorLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#CC000000"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚠"
            android:textColor="@color/accent"
            android:textSize="52sp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/errorText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/error_load_failed"
            android:textColor="@color/text_white"
            android:textSize="18sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/error_retry_hint"
            android:textColor="@color/text_hint"
            android:textSize="14sp"
            android:layout_marginTop="12dp" />
    </LinearLayout>

    <!-- ── Loading spinner ── -->
    <ProgressBar
        android:id="@+id/loadingProgress"
        style="@android:style/Widget.ProgressBar.Large"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminateTint="@color/accent"
        android:visibility="gone" />

    <!-- ── Sidebar (360dp wide, slides in/out from left) ── -->
    <LinearLayout
        android:id="@+id/sidebar"
        android:layout_width="360dp"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:elevation="8dp">

        <!-- Sidebar main content -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@color/bg_sidebar">

            <!-- Source header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingLeft="22dp"
                android:paddingRight="22dp"
                android:paddingTop="22dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_source_title"
                    android:textColor="@color/text_hint"
                    android:textSize="11sp"
                    android:letterSpacing="0.15"
                    android:layout_marginBottom="12dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/sourceTabsRv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:focusable="false"
                    android:nestedScrollingEnabled="false" />

            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginTop="16dp" />

            <!-- Channel count -->
            <TextView
                android:id="@+id/chCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="22dp"
                android:paddingTop="8dp"
                android:paddingBottom="6dp"
                android:textColor="@color/text_disabled"
                android:textSize="11sp" />

            <!-- Channel list RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/channelListRv"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scrollbars="none"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:descendantFocusability="blocksDescendants"
                android:overScrollMode="never" />

            <!-- Footer hints -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="26dp"
                android:paddingBottom="16dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/divider"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/hint_keys"
                    android:textColor="@color/text_disabled"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Right border 3dp red -->
        <View
            android:layout_width="3dp"
            android:layout_height="match_parent"
            android:background="@color/accent" />
    </LinearLayout>

    <!-- ── Now-playing bar ── -->
    <LinearLayout
        android:id="@+id/nowBar"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:gravity="center_vertical|bottom"
        android:paddingBottom="18dp"
        android:paddingEnd="44dp"
        android:background="@drawable/bg_gradient_bottom">

        <!-- Animated spacer: 360dp when sidebar visible, 44dp when hidden -->
        <View
            android:id="@+id/nowBarSpacer"
            android:layout_width="360dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/liveBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_live"
            android:textColor="@color/text_white"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:background="@drawable/bg_live_badge"
            android:layout_marginEnd="16dp" />

        <TextView
            android:id="@+id/nowSrcPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/accent_light"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:background="@drawable/bg_src_pill"
            android:layout_marginEnd="12dp" />

        <TextView
            android:id="@+id/nowName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_white"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" · "
            android:textColor="@color/text_hint"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/nowProg"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text_sub"
            android:textSize="14sp"
            android:ellipsize="end"
            android:singleLine="true" />

        <TextView
            android:id="@+id/clockText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_hint"
            android:textSize="25sp"
            android:text="--:--:--"
            android:letterSpacing="0.12" />

    </LinearLayout>

    <!-- ── Menu hint (top-right) ── -->
    <TextView
        android:id="@+id/menuHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="24dp"
        android:text="@string/hint_menu"
        android:textColor="@color/text_disabled"
        android:textSize="12sp" />

</FrameLayout>
